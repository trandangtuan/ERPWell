<div class="manage-dashboard">
  <section class="manage-page-header">
    <div>
      <p class="manage-eyebrow">Profit</p>
      <h1>Gross Profit</h1>
      <p>Estimate monthly gross profit from completed invoice lines and product cost prices.</p>
    </div>
    <%= link_to fa_icon("file-text", text: "Invoices"), invoices_path, class: "btn btn-sale-primary" %>
  </section>

  <section class="stat-grid">
    <div class="stat-card">
      <span class="stat-icon"><%= fa_icon "line-chart" %></span>
      <span class="stat-label">Monthly revenue</span>
      <strong><%= number_to_dong(@month_revenue) %></strong>
    </div>
    <div class="stat-card">
      <span class="stat-icon"><%= fa_icon "shopping-basket" %></span>
      <span class="stat-label">Estimated cost</span>
      <strong><%= number_to_dong(@month_cost) %></strong>
    </div>
    <div class="stat-card">
      <span class="stat-icon"><%= fa_icon "money" %></span>
      <span class="stat-label">Gross profit</span>
      <strong><%= number_to_dong(@gross_profit) %></strong>
    </div>
    <div class="stat-card">
      <span class="stat-icon"><%= fa_icon "percent" %></span>
      <span class="stat-label">Gross margin</span>
      <strong><%= @profit_margin %>%</strong>
    </div>
  </section>

  <div class="dashboard-layout">
    <section class="dashboard-panel">
      <div class="panel-heading">
        <div>
          <p class="manage-eyebrow">Product profit</p>
          <h2>Top revenue products</h2>
        </div>
      </div>

      <div class="table-responsive">
        <table class="table table-sm dashboard-table">
          <thead>
            <tr>
              <th>Product</th>
              <th class="text-right">Qty</th>
              <th class="text-right">Revenue</th>
              <th class="text-right">Cost</th>
              <th class="text-right">Profit</th>
            </tr>
          </thead>
          <tbody>
            <% @profit_products.each do |product| %>
              <% profit = (product.revenue || 0) - (product.cost || 0) %>
              <tr>
                <td><%= link_to product.name, product_path(product) %></td>
                <td class="text-right"><%= number_with_delimiter(product.sold_quantity || 0) %></td>
                <td class="text-right"><%= number_to_dong(product.revenue || 0) %></td>
                <td class="text-right"><%= number_to_dong(product.cost || 0) %></td>
                <td class="text-right"><strong><%= number_to_dong(profit) %></strong></td>
              </tr>
            <% end %>
            <% if @profit_products.blank? %>
              <tr>
                <td colspan="5" class="empty-row">No completed sales this month.</td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </section>

    <section class="dashboard-panel">
      <div class="panel-heading">
        <div>
          <p class="manage-eyebrow">Cash view</p>
          <h2>Purchase payments</h2>
        </div>
      </div>

      <div class="profit-summary">
        <span class="profit-summary-icon"><%= fa_icon "credit-card" %></span>
        <strong><%= number_to_dong(@paid_purchases) %></strong>
        <p>Paid purchase amount recorded this month.</p>
      </div>
      <p class="panel-note">Gross profit is estimated from product cost prices. Keep product costs updated for more accurate reporting.</p>
    </section>
  </div>
</div>
