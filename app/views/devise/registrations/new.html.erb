<div class="d-flex justify-content-center">
  <div class="card login-card">
    <div class="card-body">

      <h3 class="card-title"><%= fa_icon "lock", text: "Register" %></h3>

      <%= form_for(resource, as: resource_name, url: registration_path(resource_name)) do |f| %>
        <%= devise_error_messages! %>

        <div class="form-group">
          <%= f.label "Full Name", class: "label-text" %><span style="color: red;">*</span><br/>
          <%= f.text_field :fullname, autofocus: true, class: "form-control", placeholder: "Enter your full name", required: true %>
        </div>

        <div class="form-group">
          <%= f.label "Phone Number", class: "label-text" %><span style="color: red;">*</span><br/>
          <%= f.telephone_field :phone, class: "form-control", placeholder: "Enter your phone number", required: true %>
        </div>

        <div class="form-group">
          <%= f.label "Email", class: "label-text" %><span style="color: red;">*</span><br/>
          <%= f.email_field :email, class: "form-control", placeholder: "Enter your email address", required: true %>
        </div>

        <div class="form-group">
          <%= label_tag 'store_name', "Store Name", class: "label-text" %><span style="color: red;">*</span><br />
          <%= text_field_tag 'store[name]', '', class: "form-control", placeholder: "Store Name: Dream Shop", required: true %>
        </div>

        <div class="form-group">
          <%= f.label "Username", class: "label-text" %><span style="color: red;">*</span><br/>
          <%= f.text_field :username, class: "form-control", placeholder: "Username for future login and usage. E.g.: Phone Number", required: true %>
        </div>

        <div class="form-row">
          <div class="col">
            <%= f.label "Password", class: "label-text" %><span style="color: red;">*</span>
            <% if @minimum_password_length %>
              <em>(at least <%= @minimum_password_length %> characters)</em>
            <% end %><br/>
            <%= f.password_field :password, autocomplete: "off", class: "form-control", required: true %>
          </div>
          <div class="col">
            <%= f.label "Confirm Password", class: "label-text" %><span style="color: red;">*</span>
            <%= f.password_field :password_confirmation, autocomplete: "off", class: "form-control", required: true %>
          </div>
        </div>

        <div class="form-group">
          <%= f.label "Province/City", class: "label-text" %><span style="color: red;">*</span>
          <%= f.text_field :area, class: "form-control", placeholder: "Enter your province or city", required: true %>
        </div>

        <div class="form-group">
          <%= f.label "District/County", class: "label-text" %><span style="color: red;">*</span>
          <%= f.text_field :district_area, class: "form-control", placeholder: "Enter your district or county", required: true %>
        </div>

        <div class="form-group">
          <%= f.label "Address", class: "label-text" %><br/>
          <%= f.text_field :address, class: "form-control", placeholder: "Your store's address" %>
        </div>

        <div class="actions text-center">
          <%= f.submit "Register", class: "btn btn-info" %>
        </div>
      <% end %>

    </div>
  </div>
</div>

<div class="d-flex justify-content-center help-text-login">
  <div style="text-align: center;">
    <%= link_to fa_icon("lock", text: "Forgot Password"), new_password_path(resource_name), class: "help-text-login" %>
    |
    <%= link_to fa_icon("sign-in", text: "Login"), new_user_session_path, class: "help-text-login" %>
  </div>
</div>


